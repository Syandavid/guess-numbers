rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // usernames/{name}: { playerId, createdAt }
    // nameLocks/{name}: { pin, playerId }  // never readable; write pin to prove ownership
    // daily/{yyyy-MM-dd}/players/{uid}: { playerId, name, correct, wrong, rankScore, t }
    // challenge/current: { flashMs, digits, holderId, holderName, heldSince }
    // challengeBeats/{uid}: { t, name }
    // rooms/{code}: { ownerId, ownerName, adminIds, antiCheat, answerSeconds, phase, roundId, number, flashMs, digits, flashAt, inputUntil, replay }
    // rooms/{code}/members/{uid}: { name, joinedAt }
    // rooms/{code}/answers/{uid}: { roundId, answer, ok, t }

    function signedIn() {
      return request.auth != null;
    }

    function isValidUsername() {
      return request.resource.data.keys().hasOnly(['playerId', 'createdAt'])
        && request.resource.data.playerId == request.auth.uid
        && request.resource.data.playerId is string
        && request.resource.data.playerId.size() >= 8
        && request.resource.data.playerId.size() <= 128
        && request.resource.data.createdAt is int;
    }

    function isValidPin() {
      return request.resource.data.pin is string
        && request.resource.data.pin.size() >= 4
        && request.resource.data.pin.size() <= 8
        && request.resource.data.pin.matches('^[A-Za-z0-9]+$');
    }

    function isValidLock() {
      return request.resource.data.keys().hasOnly(['pin', 'playerId'])
        && isValidPin()
        && request.resource.data.playerId == request.auth.uid
        && request.resource.data.playerId is string
        && request.resource.data.playerId.size() >= 8
        && request.resource.data.playerId.size() <= 128;
    }

    function lockDoc(uname) {
      return get(/databases/$(database)/documents/nameLocks/$(uname)).data;
    }

    function isValidDailyPlayer(pid, day) {
        return request.resource.data.keys().hasOnly(['playerId', 'name', 'correct', 'wrong', 'rankScore', 't'])
        && request.resource.data.playerId == request.auth.uid
        && request.resource.data.playerId == pid
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 8
        && request.resource.data.correct is int
        && request.resource.data.wrong is int
        && request.resource.data.rankScore is int
        && request.resource.data.t is int
        && request.resource.data.correct >= 0
        && request.resource.data.wrong >= 0
        && request.resource.data.correct <= 100000
        && request.resource.data.wrong <= 100000
        && request.resource.data.correct + request.resource.data.wrong <= 100000
        && request.resource.data.rankScore == request.resource.data.correct * 10000 - request.resource.data.wrong;
    }

    function isValidChallengeCurrent() {
      return request.resource.data.keys().hasOnly(['flashMs', 'digits', 'holderId', 'holderName', 'heldSince'])
        && request.resource.data.flashMs is int
        && request.resource.data.flashMs >= 50
        && request.resource.data.flashMs <= 1000
        && request.resource.data.digits is int
        && request.resource.data.digits >= 1
        && request.resource.data.digits <= 15
        && request.resource.data.holderId is string
        && request.resource.data.holderId.size() <= 128
        && request.resource.data.holderName is string
        && request.resource.data.holderName.size() >= 2
        && request.resource.data.holderName.size() <= 8
        && request.resource.data.heldSince is int
        && request.resource.data.heldSince >= 0
        && (
          (request.resource.data.holderId == '' && request.resource.data.holderName == '系统')
          || (
            exists(/databases/$(database)/documents/challengeBeats/$(request.resource.data.holderId))
            && get(/databases/$(database)/documents/challengeBeats/$(request.resource.data.holderId)).data.name == request.resource.data.holderName
          )
        );
    }

    function isValidChallengeBeat(uid) {
      return request.resource.data.keys().hasOnly(['t', 'name'])
        && request.resource.data.t is int
        && request.resource.data.t >= 0
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 8;
    }

    function isValidRoom(code) {
      return code.matches('^[1-9][0-9]{3}$')
        && request.resource.data.keys().hasOnly([
          'ownerId', 'ownerName', 'adminIds', 'antiCheat', 'answerSeconds',
          'phase', 'roundId', 'number', 'flashMs', 'digits', 'flashAt',
          'inputUntil', 'replay'
        ])
        && request.resource.data.ownerId is string
        && request.resource.data.ownerId.size() >= 8
        && request.resource.data.ownerId.size() <= 128
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() >= 2
        && request.resource.data.ownerName.size() <= 8
        && request.resource.data.adminIds is list
        && request.resource.data.antiCheat is bool
        && request.resource.data.answerSeconds is int
        && request.resource.data.answerSeconds >= 1
        && request.resource.data.answerSeconds <= 15
        && request.resource.data.phase in ['lobby', 'flash', 'input', 'reveal']
        && request.resource.data.roundId is int
        && request.resource.data.roundId >= 0
        && request.resource.data.roundId <= 1000000
        && request.resource.data.number is string
        && request.resource.data.number.matches('^[0-9]*$')
        && request.resource.data.number.size() <= 15
        && request.resource.data.flashMs is int
        && request.resource.data.flashMs >= 50
        && request.resource.data.flashMs <= 1000
        && request.resource.data.digits is int
        && request.resource.data.digits >= 1
        && request.resource.data.digits <= 15
        && request.resource.data.flashAt is int
        && request.resource.data.flashAt >= 0
        && request.resource.data.inputUntil is int
        && request.resource.data.inputUntil >= 0
        && request.resource.data.replay is bool;
    }

    function isValidMember() {
      return request.resource.data.keys().hasOnly(['name', 'joinedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 8
        && request.resource.data.joinedAt is int
        && request.resource.data.joinedAt >= 0;
    }

    function isValidAnswer(code) {
      return request.resource.data.keys().hasOnly(['roundId', 'answer', 'ok', 't'])
        && request.resource.data.roundId is int
        && request.resource.data.roundId == get(/databases/$(database)/documents/rooms/$(code)).data.roundId
        && request.resource.data.answer is string
        && request.resource.data.answer.matches('^[0-9]*$')
        && request.resource.data.answer.size() <= 15
        && request.resource.data.ok is bool
        && request.resource.data.t is int
        && request.resource.data.t >= 0;
    }

    function ownsName() {
      let n = request.resource.data.name;
      return exists(/databases/$(database)/documents/usernames/$(n))
        && get(/databases/$(database)/documents/usernames/$(n)).data.playerId == request.auth.uid;
    }

    match /usernames/{uname} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && isValidUsername();
      allow update: if signedIn()
        && isValidUsername()
        && request.resource.data.createdAt == resource.data.createdAt
        && exists(/databases/$(database)/documents/nameLocks/$(uname))
        && lockDoc(uname).playerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.playerId == request.auth.uid;
    }

    match /nameLocks/{uname} {
      allow get, list: if false;
      allow create: if signedIn()
        && isValidLock()
        && exists(/databases/$(database)/documents/usernames/$(uname))
        && get(/databases/$(database)/documents/usernames/$(uname)).data.playerId == request.auth.uid;
      allow update: if signedIn()
        && isValidLock()
        && request.resource.data.pin == resource.data.pin;
      allow delete: if signedIn() && resource.data.playerId == request.auth.uid;
    }

    match /daily/{day}/players/{pid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == pid
        && isValidDailyPlayer(pid, day)
        && ownsName();
      allow delete: if signedIn() && (
        request.auth.uid == pid
        || (
          resource.data.name is string
          && exists(/databases/$(database)/documents/usernames/$(resource.data.name))
          && get(/databases/$(database)/documents/usernames/$(resource.data.name)).data.playerId == request.auth.uid
        )
      );
    }

    match /challenge/current {
      allow read: if signedIn();
      allow create: if signedIn() && isValidChallengeCurrent();
      allow update: if signedIn()
        && isValidChallengeCurrent()
        && (
          (
            request.resource.data.holderId == request.auth.uid
            && exists(/databases/$(database)/documents/challengeBeats/$(request.auth.uid))
          )
          || (
            request.resource.data.holderId == ''
            && request.resource.data.flashMs == resource.data.flashMs
            && request.resource.data.digits == resource.data.digits
            && (
              resource.data.holderId == request.auth.uid
              || (
                resource.data.holderName is string
                && resource.data.holderName.size() >= 2
                && exists(/databases/$(database)/documents/usernames/$(resource.data.holderName))
                && get(/databases/$(database)/documents/usernames/$(resource.data.holderName)).data.playerId == request.auth.uid
              )
            )
          )
        );
      allow delete: if false;
    }

    match /challengeBeats/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && isValidChallengeBeat(uid)
        && ownsName();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    function roomDoc(code) {
      return get(/databases/$(database)/documents/rooms/$(code)).data;
    }

    function isOwner(code) {
      return signedIn() && roomDoc(code).ownerId == request.auth.uid;
    }

    function isAdmin(code) {
      return signedIn() && (
        roomDoc(code).ownerId == request.auth.uid
        || request.auth.uid in roomDoc(code).adminIds
      );
    }

    function isMember(code) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(code)/members/$(request.auth.uid));
    }

    match /rooms/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isValidRoom(code);
      allow update: if signedIn() && (
        (
          isValidRoom(code)
          && (
            resource.data.ownerId == request.auth.uid
            || request.auth.uid in resource.data.adminIds
          )
        )
        || (
          isMember(code)
          && isValidRoom(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])
        )
      );
      allow delete: if isOwner(code);
    }

    match /rooms/{code}/members/{uid} {
      allow read: if signedIn() && isMember(code);
      allow create: if signedIn()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/rooms/$(code))
        && isValidMember();
      allow update: if signedIn()
        && (request.auth.uid == uid || isAdmin(code))
        && isValidMember();
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin(code));
    }

    match /rooms/{code}/answers/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && isMember(code)
        && isValidAnswer(code);
      allow update: if signedIn()
        && request.auth.uid == uid
        && isMember(code)
        && isValidAnswer(code);
      allow read: if signedIn() && isMember(code) && (
        uid == request.auth.uid
        || roomDoc(code).phase == 'reveal'
        || exists(/databases/$(database)/documents/rooms/$(code)/answers/$(request.auth.uid))
      );
      allow delete: if isAdmin(code);
    }
  }
}
