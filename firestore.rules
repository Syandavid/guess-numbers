rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // usernames/{name}: { playerId, createdAt }
    // nameLocks/{name}: { pin, playerId }  // never readable; write pin to prove ownership
    // daily/{yyyy-MM-dd}/players/{uid}: { playerId, name, correct, wrong, rankScore, t }
    // challenge/current: { flashMs, digits, holderId, holderName, heldSince }
    // challenge/beats/{uid}: { t, name }
    // rooms/{code}: { ownerId, ownerName, adminIds, antiCheat, answerSeconds, phase, roundId, number, flashMs, digits, flashAt, inputUntil, replay }
    // rooms/{code}/members/{uid}: { name, joinedAt }
    // rooms/{code}/answers/{uid}: { roundId, answer, ok, t }

    function signedIn() {
      return request.auth != null;
    }

    function isValidUsername() {
      return request.resource.data.keys().hasOnly(['playerId', 'createdAt'])
        && request.resource.data.playerId == request.auth.uid
        && request.resource.data.playerId is string
        && request.resource.data.playerId.size() >= 8
        && request.resource.data.playerId.size() <= 128
        && request.resource.data.createdAt is int;
    }

    function isValidPin() {
      return request.resource.data.pin is string
        && request.resource.data.pin.size() >= 4
        && request.resource.data.pin.size() <= 8
        && request.resource.data.pin.matches('^[A-Za-z0-9]+$');
    }

    function isValidLock() {
      return request.resource.data.keys().hasOnly(['pin', 'playerId'])
        && isValidPin()
        && request.resource.data.playerId == request.auth.uid
        && request.resource.data.playerId is string
        && request.resource.data.playerId.size() >= 8
        && request.resource.data.playerId.size() <= 128;
    }

    function lockDoc(uname) {
      return get(/databases/$(database)/documents/nameLocks/$(uname)).data;
    }

    function isValidDailyPlayer(pid) {
      return request.resource.data.keys().hasOnly(['playerId', 'name', 'correct', 'wrong', 'rankScore', 't'])
        && request.resource.data.playerId == request.auth.uid
        && request.resource.data.playerId == pid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 8
        && request.resource.data.correct is int
        && request.resource.data.wrong is int
        && request.resource.data.rankScore is int
        && request.resource.data.t is int
        && request.resource.data.correct >= 0
        && request.resource.data.wrong >= 0
        && request.resource.data.correct <= 100000
        && request.resource.data.wrong <= 100000;
    }

    function ownsName() {
      let n = request.resource.data.name;
      return exists(/databases/$(database)/documents/usernames/$(n))
        && get(/databases/$(database)/documents/usernames/$(n)).data.playerId == request.auth.uid;
    }

    match /usernames/{uname} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && isValidUsername();
      allow update: if signedIn()
        && isValidUsername()
        && request.resource.data.createdAt == resource.data.createdAt
        && exists(/databases/$(database)/documents/nameLocks/$(uname))
        && lockDoc(uname).playerId == request.auth.uid;
      allow delete: if false;
    }

    match /nameLocks/{uname} {
      allow get, list: if false;
      allow create: if signedIn()
        && isValidLock()
        && exists(/databases/$(database)/documents/usernames/$(uname))
        && get(/databases/$(database)/documents/usernames/$(uname)).data.playerId == request.auth.uid;
      allow update: if signedIn()
        && isValidLock()
        && request.resource.data.pin == resource.data.pin;
      allow delete: if false;
    }

    match /daily/{day}/players/{pid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == pid
        && isValidDailyPlayer(pid)
        && ownsName();
      allow delete: if false;
    }

    match /challenge/current {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn()
        && exists(/databases/$(database)/documents/challenge/beats/$(request.auth.uid));
      allow delete: if false;
    }

    match /challenge/beats/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    function roomDoc(code) {
      return get(/databases/$(database)/documents/rooms/$(code)).data;
    }

    function isOwner(code) {
      return signedIn() && roomDoc(code).ownerId == request.auth.uid;
    }

    function isAdmin(code) {
      return signedIn() && (
        roomDoc(code).ownerId == request.auth.uid
        || request.auth.uid in roomDoc(code).adminIds
      );
    }

    function isMember(code) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(code)/members/$(request.auth.uid));
    }

    match /rooms/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && code.matches('^[1-9][0-9]{3}$');
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || request.auth.uid in resource.data.adminIds
        || (
          isMember(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])
        )
      );
      allow delete: if isOwner(code);
    }

    match /rooms/{code}/members/{uid} {
      allow read: if signedIn() && isMember(code);
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if signedIn() && (request.auth.uid == uid || isAdmin(code));
    }

    match /rooms/{code}/answers/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && isMember(code);
      allow update: if signedIn() && request.auth.uid == uid && isMember(code);
      allow read: if signedIn() && isMember(code) && (
        uid == request.auth.uid
        || roomDoc(code).phase == 'reveal'
        || exists(/databases/$(database)/documents/rooms/$(code)/answers/$(request.auth.uid))
      );
      allow delete: if isAdmin(code);
    }
  }
}
